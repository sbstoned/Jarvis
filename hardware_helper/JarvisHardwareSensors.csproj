<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseAppHost>true</UseAppHost>
    <AssemblyName>JarvisHardwareSensors</AssemblyName>
    <RootNamespace>JarvisHardwareSensors</RootNamespace>
    <OutputPath>..\tools\JarvisHardwareSensors\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <Reference Include="LibreHardwareMonitorLib">
      <HintPath>..\tools\LibreHardwareMonitor\LibreHardwareMonitorLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Management">
      <HintPath>..\tools\LibreHardwareMonitor\System.Management.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="..\tools\LibreHardwareMonitor\*.dll"
             Exclude="..\tools\LibreHardwareMonitor\LibreHardwareMonitorLib.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\tools\LibreHardwareMonitor\runtimes\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
