  "component_boundary_policy": {
    "version": 1,
    "rule": "Build/test commands may consume component-owned configuration or explicitly planned shared configuration only.",
    "repair": "When a conventional config reference is invalid, prefer the canonical config at the current component root; never fabricate a config inside a foreign component merely to satisfy a bad command."
  }
