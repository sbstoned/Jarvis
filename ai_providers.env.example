# JARVIS optional direct AI provider configuration
# Do NOT put real keys in files you share publicly.

# OpenAI: Jarvis will already use OPENAI_API_KEY from the Hermes .env if present.
# OPENAI_API_KEY=sk-...
JARVIS_OPENAI_MODEL=gpt-5.6-sol

# Claude / Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local Qwen via llama.cpp (free/local)
JARVIS_QWEN_BASE_URL=http://127.0.0.1:8081
JARVIS_QWEN_MODEL=qwen-local
JARVIS_QWEN_27B_MODEL_PATH=D:\Qwen3.8-27B-OBLITERATED\GGUF\Qwen3.8-27B-OBLITERATED-Q4_K_M.gguf
JARVIS_QWEN_8B_MODEL_PATH=D:\Qwen3-8B-Abliterated\GGUF\Qwen3-8B-abliterated.i1-Q4_K_M.gguf
JARVIS_QWEN_TIMEOUT=900
# Keep 0 for this model's recommended empty system prompt.
JARVIS_QWEN_USE_SYSTEM_PROMPT=0

# Local Qwen streaming: 10-minute no-progress watchdog; no wall-clock hard limit.
JARVIS_QWEN_STREAM_IDLE_TIMEOUT=600
JARVIS_QWEN_STREAM_HARD_TIMEOUT=600

# Qwen3.5 V32 throughput defaults (normally leave unset to use these automatically)
# JARVIS_QWEN_35_CONTEXT=262144
# JARVIS_QWEN35_TRY_YARN=0
